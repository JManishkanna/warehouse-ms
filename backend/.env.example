# Environment Variables — Copy this to .env or set as system env vars
DB_URL=jdbc:mysql://localhost:3306/warehouse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Generate a strong random 256-bit key for production
JWT_SECRET=change-this-to-a-strong-random-256-bit-secret-key-in-production
JWT_EXPIRATION_MS=86400000

PORT=8081
CORS_ORIGINS=http://localhost:5111,http://localhost:5173,http://localhost:3000
